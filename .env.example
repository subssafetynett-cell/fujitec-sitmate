# Application
NODE_ENV=production

# Public URL (Coolify domain). Used for CORS and links.
APP_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example

# Postgres (compose `db` service)
POSTGRES_USER=safetyuser
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=safetyapp_db
DATABASE_URL=postgresql://safetyuser:change-me-strong-password@db:5432/safetyapp_db

# Backend
BACKEND_PORT=4000
PORT=4000

# Bootstrap Super Admin (created on backend start if missing)
SUPERADMIN_EMAIL=superadmin@sheq.local
SUPERADMIN_PASSWORD=SuperAdmin1!
SUPERADMIN_NAME=Super Admin
SUPERADMIN_COMPANY=Sitemate
# Set to true once to reset the bootstrap Super Admin password to SUPERADMIN_PASSWORD
SUPERADMIN_RESET=false

# Frontend
# Coolify / production: leave empty so the browser uses same-origin /api (nginx → backend)
FRONTEND_PORT=8082
VITE_API_URL=
# Local Vite overlay only (docker-compose.local.yml)
VITE_API_PROXY_TARGET=http://backend:4000

# Cloudinary (logos, signatures, site-pack files)
# Prefer either CLOUDINARY_URL **or** the three discrete values below.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
